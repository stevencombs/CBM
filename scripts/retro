#!/usr/bin/env bash
# Open a machine profile in Zed.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
machine="$(echo "${1:-}" | tr '[:upper:]' '[:lower:]')"
case "$machine" in
  vic20|vic|vic-20|v)
    exec zed -n "$ROOT/VIC20"
    ;;
  c64|c)
    exec zed -n "$ROOT/C64"
    ;;
  mega65|m65|m)
    exec zed -n "$ROOT/MEGA65"
    ;;
  *)
    echo "usage: retro vic20 | c64 | mega65" >&2
    exit 2
    ;;
esac
