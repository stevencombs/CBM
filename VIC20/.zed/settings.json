{
  "theme": {
    "mode": "dark",
    "dark": "VIC-20 Cyan",
    "light": "VIC-20 Cyan"
  },
  "buffer_font_family": "Source Code Pro",
  "buffer_font_size": 20,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "agent_ui_font_family": "Source Code Pro",
  "agent_ui_font_size": 18,
  "agent_buffer_font_family": "Source Code Pro",
  "agent_buffer_font_size": 16,
  "agent": {
    "dock": "right",
    "button": true,
    "default_width": 480,
    "default_view": "text_thread",
    "terminal_init_command": "/Users/stevencombs/.grok/bin/grok"
  },
  "agent_servers": {
    "Grok Build": {
      "type": "custom",
      "command": "/Users/stevencombs/.grok/bin/grok",
      "args": ["agent", "stdio"],
      "env": {
        "HOME": "/Users/stevencombs",
        "PATH": "/opt/homebrew/bin:/Users/stevencombs/.grok/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      }
    }
  },
  "terminal": {
    "dock": "bottom"
  },
  "project_panel": {
    "dock": "left"
  },
  "file_associations": {
    "*.bas": "VIC-20 BASIC"
  }
}
