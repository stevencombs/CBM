{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "VIC-20",
  "author": "retroCombs",
  "themes": [
    {
      "name": "VIC-20 Cyan",
      "appearance": "dark",
      "style": {
        "background": "#000000",
        "surface.background": "#000000",
        "elevated_surface.background": "#001800",
        "panel.background": "#000000",
        "panel.focused_border": "#00FF00",
        "status_bar.background": "#000000",
        "title_bar.background": "#000000",
        "toolbar.background": "#000000",
        "tab_bar.background": "#000000",
        "tab.active_background": "#001800",
        "tab.inactive_background": "#000000",
        "border": "#00AA00",
        "border.variant": "#005500",
        "text": "#00FF00",
        "text.muted": "#00AA00",
        "text.placeholder": "#007700",
        "text.disabled": "#005500",
        "text.accent": "#33FF33",
        "icon": "#00FF00",
        "icon.muted": "#00AA00",
        "icon.accent": "#33FF33",
        "element.background": "#001800",
        "element.hover": "#002200",
        "element.selected": "#003300",
        "ghost_element.hover": "#002200",
        "ghost_element.selected": "#003300",
        "drop_target.background": "#003300",

        "editor.background": "#5CEEEE",
        "editor.foreground": "#40318D",
        "editor.gutter.background": "#4ADADA",
        "editor.active_line.background": "#7AFFFF",
        "editor.line_number": "#2A2A8F",
        "editor.active_line_number": "#000080",
        "editor.cursor": "#40318D",
        "editor.selection": "#FFFFFF80",
        "editor.invisible": "#40318D55",
        "editor.wrap_guide": "#40318D33",
        "editor.active_wrap_guide": "#40318D66",

        "terminal.background": "#000000",
        "terminal.foreground": "#00FF00",
        "terminal.ansi.black": "#000000",
        "terminal.ansi.red": "#FF5555",
        "terminal.ansi.green": "#00FF00",
        "terminal.ansi.yellow": "#BBFF00",
        "terminal.ansi.blue": "#00AAFF",
        "terminal.ansi.magenta": "#AAFFAA",
        "terminal.ansi.cyan": "#55FFFF",
        "terminal.ansi.white": "#AAFFAA",
        "terminal.ansi.bright_black": "#005500",
        "terminal.ansi.bright_green": "#33FF33",
        "terminal.ansi.bright_white": "#FFFFFF",

        "agent_panel.text.foreground": "#00FF00",
        "agent_panel.muted_text.foreground": "#00AA00",
        "agent_panel.code_block.background": "#001800",
        "agent_panel.code_block.foreground": "#00FF00",
        "agent_panel.code_block.border": "#00AA00",
        "agent_panel.inline_code.background": "#001800",
        "agent_panel.inline_code.foreground": "#33FF33",
        "agent_panel.user_message.background": "#001800",
        "agent_panel.user_message.foreground": "#00FF00",
        "agent_panel.user_message.border": "#00AA00",
        "agent_panel.link.foreground": "#33FF33",

        "syntax": {
          "comment": { "color": "#2A6A6A", "font_style": "italic" },
          "comment.doc": { "color": "#2A6A6A", "font_style": "italic" },
          "keyword": { "color": "#000080", "font_weight": 700 },
          "function": { "color": "#000080" },
          "string": { "color": "#0000AA" },
          "number": { "color": "#800000" },
          "constant": { "color": "#800000" },
          "operator": { "color": "#000080" },
          "punctuation": { "color": "#40318D" },
          "variable": { "color": "#40318D" },
          "type": { "color": "#000080" }
        }
      }
    }
  ]
}
